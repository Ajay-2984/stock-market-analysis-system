import sqlite3
import pandas as pd

from scripts.ui import title, error, pause
from scripts.logger import log_info, log_error


def search_by_company():

    try:

        title("SEARCH BY COMPANY")

        company = input("\nEnter Company Name : ").upper()

        connection = sqlite3.connect("stock_market.db")

        query = """
        SELECT *
        FROM stocks
        WHERE company_name = ?
        """

        df = pd.read_sql(
            query,
            connection,
            params=(company,)
        )

        connection.close()

        if df.empty:

            error("No Records Found")

            log_error(f"Company Search Failed : {company}")
