import sqlite3
import pandas as pd


# DATABASE CONNECTION
conn = sqlite3.connect(
    "stock_market.db"
)


# COMPANY COMPARISON

def compare_companies():

    # USER INPUT
    company1 = input(
        "Enter first company: "
    )

    company2 = input(
        "Enter second company: "
    )

    query = """
    SELECT

        company_name,

        AVG(close_price) AS average_price,

        MAX(high_price) AS highest_price,

        MIN(low_price) AS lowest_price

    FROM stocks

    WHERE company_name IN (?, ?)

    GROUP BY company_name
    """

    df = pd.read_sql(

        query,

        conn,

        params=(company1, company2)

    )

    # CHECK EMPTY
    if df.empty:

        print(
            "\nNo company data found"
        )

        return

    print(
        "\n===== COMPANY COMPARISON ====="
    )

    print(
        df.round(2)
    )
